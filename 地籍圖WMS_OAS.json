{
  "openapi": "3.1.1",
  "info": {
    "title": "國土測繪圖資雲地籍圖WMS服務",
    "version": "v1.0",
    "description": "提供 OGC WMS 標準服務，支援 GetCapabilities、GetMap 與 GetFeatureInfo。"
  },
  "servers": [
    {
      "url": "https://landmaps.nlsc.gov.tw"
    }
  ],
  "tags": [
    {
      "name": "地籍圖 WMS",
      "description": "Web Map Service 標準服務"
    }
  ],
  "paths": {
    "/S_Maps/wms": {
      "get": {
        "tags": [
          "地籍圖 WMS"
        ],
        "summary": "WMS_地籍圖",
        "description": "支援 OGC WMS 操作：GetCapabilities、GetMap、GetFeatureInfo。",
        "operationId": "2dms_cadwms_v1_DMAPS",
        "x-updateTime": "2026-07-02-00-00-00",
        "parameters": [
          {
            "name": "SERVICE",
            "in": "query",
            "required": true,
            "description": "服務類型，固定為 WMS",
            "schema": {
              "type": "string",
              "enum": [
                "WMS"
              ],
              "default": "WMS"
            }
          },
          {
            "name": "REQUEST",
            "in": "query",
            "required": true,
            "description": "請求操作類型",
            "schema": {
              "type": "string",
              "enum": [
                "GetCapabilities",
                "GetMap",
                "GetFeatureInfo"
              ],
              "default": "GetCapabilities"
            }
          },
          {
            "name": "VERSION",
            "in": "query",
            "required": true,
            "description": "WMS 版本，常用 1.1.1 或 1.3.0",
            "schema": {
              "type": "string",
              "enum": [
                "1.1.1",
                "1.3.0"
              ],
              "default": "1.3.0"
            }
          },
          {
            "name": "LAYERS",
            "in": "query",
            "required": false,
            "description": "欲查詢圖層 (GetMap 使用，固定為 DMAPS 地籍圖磚)",
            "schema": {
              "type": "string",
              "enum": [
                "DMAPS"
              ],
              "default": "DMAPS"
            }
          },
          {
            "name": "STYLES",
            "in": "query",
            "required": false,
            "description": "樣式名稱，可留空代表預設樣式",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "CRS",
            "in": "query",
            "required": false,
            "description": "座標參考系統 (例如 EPSG:3857, EPSG:4326)",
            "schema": {
              "type": "string",
              "enum": [
                "EPSG:3857",
                "EPSG:4326",
                "EPSG:3826",
                "EPSG:3825"
              ],
              "default": "EPSG:3857"
            }
          },
          {
            "name": "BBOX",
            "in": "query",
            "required": false,
            "description": "邊界框 (minX,minY,maxX,maxY)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "WIDTH",
            "in": "query",
            "required": false,
            "description": "輸出影像寬度（像素）",
            "schema": {
              "type": "integer",
              "default": 256
            }
          },
          {
            "name": "HEIGHT",
            "in": "query",
            "required": false,
            "description": "輸出影像高度（像素）",
            "schema": {
              "type": "integer",
              "default": 256
            }
          },
          {
            "name": "FORMAT",
            "in": "query",
            "required": false,
            "description": "輸出影像格式",
            "schema": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg"
              ],
              "default": "image/png"
            }
          },
          {
            "name": "QUERY_LAYERS",
            "in": "query",
            "required": false,
            "description": "欲查詢圖層 (GetFeatureInfo 使用，固定為 DMAPS 地籍圖磚)",
            "schema": {
              "type": "string",
              "enum": [
                "DMAPS"
              ],
              "default": "DMAPS"
            }
          },
          {
            "name": "INFO_FORMAT",
            "in": "query",
            "required": false,
            "description": "GetFeatureInfo 回應格式 (如 application/json, text/html, application/xml)",
            "schema": {
              "type": "string",
              "enum": [
                "application/json",
                "text/html",
                "application/xml"
              ],
              "default": "application/json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功回傳 WMS 回應",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "請求參數錯誤"
          }
        }
      }
    }
  }
}